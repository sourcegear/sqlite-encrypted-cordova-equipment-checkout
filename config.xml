<?xml version="1.0" encoding="utf-8"?>
<widget id="org.sqlite.encrypted.examples.equipmentcheckout"
        version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Encrypted Equipment Checkout</name>
    <description>An encrypted offline equipment checkout example for SQLite.Encrypted.</description>
    <author email="support@sourcegear.com" href="https://sqlite.sourcegear.com/">SourceGear</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidXEnabled" value="true" />
</widget>

